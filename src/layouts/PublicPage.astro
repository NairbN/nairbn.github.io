---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { loadPublic } from '../lib/load-data';
import type { PublicData } from '../lib/types';
import '../styles/public.css';

interface Props { page: string; title: string; description: string; path: string }
const { page, title, description, path } = Astro.props;
const SITE = 'https://nairbn.github.io';
const d = loadPublic() as unknown as PublicData;
---
<Base page={page} title={title} description={description} canonical={`${SITE}${path}`} ogImage={`${SITE}/og.png`}>
  <Nav page={page} />
  <slot />
  <Footer generated={d.generated_at} />
  <script>
    import '../client/public';
  </script>
</Base>
