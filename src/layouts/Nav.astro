---
interface Props { links: { href: string; label: string }[]; brand: string; brandHref?: string; label?: string }
const { links, brand, brandHref = '#top', label = 'Sections' } = Astro.props;
---
<header class="nav">
  <div class="wrap nav-in">
    <a class="brand" href={brandHref} aria-label={`${brand}, top of page`}>
      <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="currentColor" opacity="0.12"/><rect x="2" y="2" width="60" height="60" rx="12" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="2.5"/><text x="32" y="43" text-anchor="middle" font-family="Inter Variable, sans-serif" font-size="28" font-weight="700" letter-spacing="-2" fill="currentColor">Hb</text><circle cx="49" cy="14" r="4.5" fill="var(--accent)"/></svg>
      <span class="brand-word">{brand}</span>
    </a>
    <nav class="nav-links" aria-label={label}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <slot />
    <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch theme" aria-pressed="false">
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</header>
