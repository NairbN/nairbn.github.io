---
import '@fontsource-variable/inter/opsz.css';
import '../styles/ds.css';
import { PHOTOS, PERIODS } from '../lib/photos';
import { bootScript } from '../lib/boot';

interface Props { title: string; description?: string; canonical?: string; ogImage?: string; robots?: string; page: string }
const { title, description = '', canonical, ogImage, robots, page } = Astro.props;

// Photo files + alt text for the inline script. Same-origin only: the internal build bundles these locally.
const internal = __TARGET__ === 'internal';
const photoMap = Object.fromEntries(PERIODS.map((p) => [p, { f: `/backdrops/${p}`, alt: PHOTOS[p].alt }]));
const boot = bootScript(photoMap);
---
<!doctype html>
<html lang="en" data-target={__TARGET__} data-page={page} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Heisenberg Lab" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        {ogImage && <meta property="og:image" content={ogImage} />}
        {ogImage && <meta property="og:image:width" content="1200" />}
        {ogImage && <meta property="og:image:height" content="630" />}
        {ogImage && <meta property="og:image:alt" content="Heisenberg Lab, a self-hosted homelab, over a glass-lit city skyline." />}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {ogImage && <meta name="twitter:image" content={ogImage} />}
      </>
    )}
    {internal ? (
      <>
        <link rel="manifest" href="/manifest.webmanifest" />
        <link rel="apple-touch-icon" href="/icon-180.png" />
        <meta name="theme-color" content="#0b0b0e" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-title" content="Heisenberg Lab" />
        <link rel="stylesheet" href="/svc-icons.css" />
        <script is:inline src="/boot.js"></script>
      </>
    ) : (
      <script is:inline set:html={boot}></script>
    )}
  </head>
  <body>
    <div class="stage" data-bd data-blur aria-hidden="true"><img alt="" /><img alt="" /></div>
    <div class="top" data-bd><img alt="" /><img alt="" /></div>
    <div class="veil" aria-hidden="true"></div>
    {internal ? <script is:inline src="/boot-init.js"></script> : <script is:inline>window.hlBackdrop && window.hlBackdrop.init();</script>}
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
