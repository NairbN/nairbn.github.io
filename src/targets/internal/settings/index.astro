---
import InternalPage from '../../../layouts/InternalPage.astro';
---
<InternalPage page="settings" title="Settings" heading="Settings" lede="Make the portal yours, and decide who and what can reach you.">
  <div class="gate card glass" id="gate" hidden>
    <h2 class="card-h">Sign in to change settings</h2>
    <p class="muted" id="gate-text">Settings are saved to the portal and need a signed-in device.</p>
    <a class="btn-solid" href="/login/" id="gate-login">Sign in</a>
  </div>
  <div class="s-root" id="s-root" hidden>
    <ul class="s-index">
      <li><a class="s-link glass" href="/settings/appearance/"><span class="s-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.8 1.8-1.7 0-1.3-1-1.5-1-2.6 0-.9.7-1.7 1.7-1.7H17a4 4 0 0 0 4-4C21 6.7 17 3 12 3z M7.5 11a1 1 0 1 0 0 .01 M10 7.5a1 1 0 1 0 0 .01 M14.5 7.5a1 1 0 1 0 0 .01" /></svg></span><span class="s-t"><b>Appearance</b><small>Photos, glass, theme and accent color.</small></span></a></li>
      <li><a class="s-link glass" href="/settings/home/"><span class="s-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 11.5 12 4.5l8 7 M6.5 10v9.5h11V10" /></svg></span><span class="s-t"><b>Home screen</b><small>Which cards Overview shows, and your launcher links.</small></span></a></li>
      <li><a class="s-link glass" href="/settings/notifications/"><span class="s-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4z M10 21h4" /></svg></span><span class="s-t"><b>Alerts</b><small>Push notifications, quiet hours and devices.</small></span></a></li>
      <li><a class="s-link glass" href="/settings/security/"><span class="s-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 5-3 8.5-7 10-4-1.5-7-5-7-10V6z" /></svg></span><span class="s-t"><b>Security</b><small>Passkeys, signed-in devices, recovery codes and the audit log.</small></span></a></li>
    </ul>
    <div class="card glass" id="acct-card">
      <h2 class="card-h">Signed in</h2>
      <p class="muted" id="acct-line"></p>
      <button type="button" class="btn-ghost" id="settings-signout">Sign out</button>
    </div>
  </div>
  <script>
    import '../../../client/settings-index';
  </script>
</InternalPage>
