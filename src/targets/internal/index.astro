---
import InternalPage from '../../layouts/InternalPage.astro';
import { loadInternal } from '../../lib/load-data';
import type { InternalData } from '../../lib/types';
import * as V from '../../lib/internal-views';
const d = loadInternal() as unknown as InternalData;
---
<InternalPage page="home" title="Overview" heading="Overview" lede="Host and GPU vitals first, then everything you launch from here.">
  <section class="isec" aria-label="Vitals"><div class="vit-grid" data-slot="vitalsHtml" set:html={V.vitalsHtml(d)} /></section>
  <section class="isec" aria-label="Lab summary"><div class="strip glass glass-strong" role="group" data-slot="statsHtml" set:html={V.statsHtml(d)} /></section>
  <section class="isec" aria-labelledby="h-launch"><h2 class="sec-h" id="h-launch">Launcher</h2><div class="launcher" data-slot="linksHtml" set:html={V.linksHtml(d)} /></section>
</InternalPage>
