---
import AuthPage from '../../layouts/AuthPage.astro';
---
<AuthPage page="login" title="Sign in" tagline="Sign in to control your lab.">
  <div id="login-main">
    <h2 class="auth-h2">Welcome back</h2>
    <p class="auth-p">Use the passkey saved on this device. Nothing is typed and nothing is sent to anyone outside your network.</p>
    <p class="note" id="login-msg" role="alert" hidden></p>
    <button type="button" class="btn-lg solid" id="login-go">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V6a2 2 0 0 1 2-2h2 M16 4h2a2 2 0 0 1 2 2v2 M20 16v2a2 2 0 0 1-2 2h-2 M8 20H6a2 2 0 0 1-2-2v-2 M9 9.5v1.5 M15 9.5v1.5 M12 9.5v3.5h-1 M9 16c1 1 2 1.3 3 1.3s2-.3 3-1.3" /></svg>
      Sign in with Face ID
    </button>
    <button type="button" class="btn-lg quiet" id="login-recovery-toggle" aria-expanded="false" aria-controls="recovery-form">Use a recovery code</button>
    <form class="recovery" id="recovery-form" hidden>
      <label for="recovery-code">Recovery code</label>
      <input class="field" id="recovery-code" name="code" autocomplete="off" autocapitalize="none" spellcheck="false" inputmode="text" placeholder="xxxx-xxxx-xxxx" />
      <p class="muted small">A recovery code lets you register a new passkey. Each code works once.</p>
      <button type="submit" class="btn-lg solid">Use code</button>
    </form>
    <a class="plain-link" href="/">Continue read-only</a>
  </div>
  <script>
    import '../../client/login';
  </script>
</AuthPage>
