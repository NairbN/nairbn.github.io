---
import PublicPage from '../../layouts/PublicPage.astro';

// Public résumé. No phone number, email or street address on this page (leakcheck enforces it).
const links = [
  { href: 'https://www.linkedin.com/in/brian-nguyen-swe/', label: 'LinkedIn', solid: true },
  { href: 'https://github.com/NairbN', label: 'GitHub' },
  { href: 'https://nairbn.github.io/', label: 'nairbn.github.io', internal: true },
];

const flagship = {
  title: 'Heisenberg Lab, Self-Hosted AI Agent Infrastructure',
  when: 'Sep 2026 – Present',
  bullets: [
    'Planned, sourced and built a Proxmox VE server (Intel Core i9-7900X, 62 GB RAM, AMD Radeon AI PRO R9700 32 GB) running 15 guests (13 LXC, 2 VMs); drives bought via DMD (~$200 saved); ~30 hrs/week.',
    'Serve local LLMs via an OpenAI-compatible llama-swap gateway over Radiance with GPU passthrough: Qwen3.8 27B at ~113 tok/s (0.14 s first token), plus a 2B model, image generation and a llama.cpp fallback.',
    'Built a multi-agent ops layer: a Hermes IT agent on Discord (read-only Proxmox token, git-backed Obsidian vault), a Claude Code admin agent with hook guardrails and subagents, and a jailed sandbox VM.',
    'Automated a job-inbox worker that sorts Outlook mail with the local LLM via Microsoft Graph, and built an isolated trading-research container for strategy backtests and paper trading.',
    'Monitoring: Prometheus, Grafana, Loki, Uptime Kuma (6 dashboards, 32 alert rules, 22 monitors, nightly model benchmarks). Security: default-deny per-guest firewall, internal-CA TLS via Caddy, AdGuard DNS, Tailscale-only remote access, Vaultwarden secrets, nightly backups.',
  ],
};

const jobs = [
  {
    role: 'Sort Technician (Sort, Wipe & Audit)',
    org: 'DMD Systems Recovery',
    place: 'Palo Alto, CA',
    when: 'Apr 2026 – Present',
    bullets: [
      'Temp to full-time; sort up to 150 assets/day and wipe/audit ~50/day at an R2v3, NAID AAA ITAD facility; also receiving and shipping.',
      'Own macOS sanitization (NIST 800-88, Ziperase), plus Dell OptiPlex for a period; grade and verify serial/model data.',
      "Found a way to clear password-locked assets so they're wiped and resold whole, not parted out.",
      'Trained a new sort technician, who was working independently after two months.',
      "Developed and deployed SortFlow (Next.js, FastAPI, Supabase, Docker): SLA work queue and live pallet floor map replacing a manual spreadsheet; presented to DMD's CIO and Director of Enterprise Applications. Prototyping an OCR serial scanner for Power Apps.",
    ],
  },
  {
    role: 'Geek Squad Consultant Agent',
    org: 'Best Buy',
    place: 'San Jose, CA',
    when: 'Oct 2025 – Feb 2026',
    bullets: [
      'Promoted from sales associate in two months; diagnosed devices, quoted repairs and logged service.',
      'Did phone screen replacements, OS installs and simple repairs; graded ~20 returns/day for Open Box.',
      'Highest credit card application numbers in Jan and Feb 2026; sold protection plans.',
    ],
  },
];

const skills = [
  { k: 'AI & agents', v: 'llama-swap, Radiance, llama.cpp, LM Studio, Hermes Agent, Claude Code, Open WebUI, RAG, OpenAI API' },
  { k: 'Infrastructure', v: 'Proxmox VE, LXC, Debian, Docker, Caddy, Tailscale, Vaultwarden, Prometheus, Grafana, Loki' },
  { k: 'Development & IT', v: 'Python, FastAPI, JavaScript, Next.js/React, SQL, Supabase, Graph API, device repair' },
];
---
<PublicPage page="resume" path="/resume/" title="Résumé | Heisenberg Lab" description="Résumé of Brian Nguyen: UC San Diego Math-CS graduate building AI agent infrastructure, targeting AI agent, AI ops and forward deployed roles.">
  <main id="main" class="page">
    <div class="wrap">
      <article class="cv glass" aria-labelledby="cv-h">
        <header class="cv-head">
          <div>
            <h1 id="cv-h">Brian Nguyen</h1>
            <p class="cv-loc">San Jose, CA</p>
          </div>
          <p class="cv-links">
            {links.map((l) => (
              <a class={l.solid ? 'btn-solid' : 'btn-ghost'} href={l.href} {...(l.internal ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>{l.label}</a>
            ))}
          </p>
        </header>

        <section class="cv-sec" aria-labelledby="cv-sum">
          <h2 id="cv-sum">Summary</h2>
          <p class="cv-p">Math-CS graduate (UC San Diego) building AI agent infrastructure on a self-run Proxmox lab, with IT hardware experience from Geek Squad and ITAD. Targeting AI agent, AI ops and forward deployed roles.</p>
        </section>

        <section class="cv-sec" aria-labelledby="cv-flag">
          <h2 id="cv-flag">Flagship project</h2>
          <div class="cv-item">
            <div class="cv-row"><h3><a href="/">{flagship.title}</a></h3><span class="cv-when">{flagship.when}</span></div>
            <ul>{flagship.bullets.map((b) => <li>{b}</li>)}</ul>
          </div>
        </section>

        <section class="cv-sec" aria-labelledby="cv-exp">
          <h2 id="cv-exp">Experience</h2>
          {jobs.map((j) => (
            <div class="cv-item">
              <div class="cv-row"><h3>{j.role}</h3><span class="cv-when">{j.when}</span></div>
              <p class="cv-org">{j.org} · {j.place}</p>
              <ul>{j.bullets.map((b) => <li>{b}</li>)}</ul>
            </div>
          ))}
        </section>

        <section class="cv-sec" aria-labelledby="cv-edu">
          <h2 id="cv-edu">Education</h2>
          <div class="cv-item">
            <div class="cv-row"><h3>B.S. Mathematics-Computer Science</h3><span class="cv-when">2025</span></div>
            <p class="cv-org">UC San Diego</p>
            <p class="cv-p">Microsoft SQL Foundations certification.</p>
          </div>
        </section>

        <section class="cv-sec" aria-labelledby="cv-skills">
          <h2 id="cv-skills">Skills</h2>
          <dl class="cv-skills">
            {skills.map((s) => (<div><dt>{s.k}</dt><dd>{s.v}</dd></div>))}
          </dl>
        </section>
      </article>
    </div>
  </main>
</PublicPage>
