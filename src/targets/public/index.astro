---
import PublicPage from '../../layouts/PublicPage.astro';
import { loadPublic } from '../../lib/load-data';
import type { PublicData } from '../../lib/types';
import * as V from '../../lib/views';
import { PHOTOS, PERIODS } from '../../lib/photos';

const d = loadPublic() as unknown as PublicData;
---
<PublicPage page="home" path="/" title="Heisenberg Lab, a self-hosted homelab by Brian Nguyen"
  description="Heisenberg Lab is a self-hosted homelab: one Proxmox host, local LLM inference on a 32 GB GPU, and AI agents that run it behind guardrails. Built by Brian Nguyen.">
  <main id="main" class="home">
    <div class="wrap">
      <div class="home-top">
        <div class="home-text">
          <div class="pill glass" data-render="pillUpdated" set:html={V.pillUpdated(d)} />
          <h1>Heisenberg<br />Lab</h1>
          <div class="fog-host">
            <span class="fog fog-dense" aria-hidden="true"></span><span class="fog fog-breath" aria-hidden="true"></span>
            <p class="home-p" data-render="homeLede" set:html={V.homeLede(d)} />
          </div>
          <a class="chip-by glass" href="/about/"><img src="/assets/brian.jpg" alt="" width="32" height="32" />Built by <strong>Brian Nguyen</strong></a>
        </div>
        <section class="home-vitals glass" aria-label="Vitals" data-render="homeVitals" set:html={V.homeVitals(d)} />
      </div>
      <div class="home-stats strip glass glass-strong" role="group" aria-label="Lab summary" data-render="homeStats" set:html={V.homeStats(d)} />
    </div>
    <div class="home-credit">
      <div class="wrap">
        <span>{PERIODS.map((p) => <span class="pc-for" data-p={p}>{PHOTOS[p].label}, {PHOTOS[p].place}</span>)}</span>
        <span>Photo: {PERIODS.map((p) => <span class="pc-for" data-p={p}>{PHOTOS[p].author} ({PHOTOS[p].license})</span>)}, via Wikimedia Commons. <a href="#credits-h">Credits</a></span>
      </div>
    </div>
  </main>
</PublicPage>
